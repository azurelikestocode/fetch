# GitHub OAuth App Configuration
# 1. Create a free OAuth app at: https://github.com/settings/applications/new
#    - Application Name: Fetch UI
#    - Homepage URL: http://localhost:3000
#    - Authorization Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Credentials (Optional)
# 1. Create credentials at: https://console.cloud.google.com/apis/credentials
#    - Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
